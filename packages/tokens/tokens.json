{
  "$description": "EyesUp design tokens in the W3C Design Tokens Community Group format. Light and dark themes share names; generate CSS custom properties per theme from color.light and color.dark.",
  "color": {
    "light": {
      "finger": {
        "index": { "$type": "color", "$value": "#E69F00", "$description": "Finger 1. Okabe-Ito orange." },
        "middle": { "$type": "color", "$value": "#56B4E9", "$description": "Finger 2. Okabe-Ito sky blue." },
        "ring": { "$type": "color", "$value": "#009E73", "$description": "Finger 3. Okabe-Ito bluish green." },
        "little": { "$type": "color", "$value": "#CC79A7", "$description": "Finger 4 and modifiers. Okabe-Ito reddish purple." },
        "thumb": { "$type": "color", "$value": "#8A8F98" }
      },
      "surface": {
        "page": { "$type": "color", "$value": "#F6F4EF" },
        "card": { "$type": "color", "$value": "#FFFFFF" },
        "key": { "$type": "color", "$value": "#FFFFFF" },
        "keyBorder": { "$type": "color", "$value": "#DAD6CD" },
        "muted": { "$type": "color", "$value": "#F1EFEA" },
        "border": { "$type": "color", "$value": "#E4E1DA" }
      },
      "ink": {
        "primary": { "$type": "color", "$value": "#16181D" },
        "secondary": { "$type": "color", "$value": "#5B616B" },
        "untyped": { "$type": "color", "$value": "#8A8F98" }
      },
      "accent": { "$type": "color", "$value": "#2F5BEA", "$description": "Caret, primary buttons, focus ring, target key." },
      "state": {
        "correct": { "$type": "color", "$value": "#1F8A4C" },
        "error": { "$type": "color", "$value": "#D12F45" },
        "warning": { "$type": "color", "$value": "#B7791F" }
      },
      "guide": {
        "outline": { "$type": "color", "$value": "#B9B5AC", "$description": "Dashed outline of a key at level L2." },
        "locked": { "$type": "color", "$value": "#ECEAE4" },
        "lockedInk": { "$type": "color", "$value": "#A3A8B0" }
      },
      "heat": {
        "low": { "$type": "color", "$value": "#E8EEFC" },
        "high": { "$type": "color", "$value": "#2F5BEA" }
      },
      "hand": {
        "fill": { "$type": "color", "$value": "#EEE9DF" },
        "line": { "$type": "color", "$value": "#8F897D" }
      }
    },
    "dark": {
      "finger": {
        "index": { "$type": "color", "$value": "#F2B33D" },
        "middle": { "$type": "color", "$value": "#7CC6F0" },
        "ring": { "$type": "color", "$value": "#2CC495" },
        "little": { "$type": "color", "$value": "#DD9CC0" },
        "thumb": { "$type": "color", "$value": "#A3A8B0" }
      },
      "surface": {
        "page": { "$type": "color", "$value": "#121417" },
        "card": { "$type": "color", "$value": "#1B1E23" },
        "key": { "$type": "color", "$value": "#23272E" },
        "keyBorder": { "$type": "color", "$value": "#353A42" },
        "muted": { "$type": "color", "$value": "#23272E" },
        "border": { "$type": "color", "$value": "#2A2E35" }
      },
      "ink": {
        "primary": { "$type": "color", "$value": "#ECEAE4" },
        "secondary": { "$type": "color", "$value": "#A3A8B0" },
        "untyped": { "$type": "color", "$value": "#8A8F98" }
      },
      "accent": { "$type": "color", "$value": "#6E8CFF" },
      "state": {
        "correct": { "$type": "color", "$value": "#4CC27F" },
        "error": { "$type": "color", "$value": "#FF6B7D" },
        "warning": { "$type": "color", "$value": "#E5A84B" }
      },
      "guide": {
        "outline": { "$type": "color", "$value": "#5B616B" },
        "locked": { "$type": "color", "$value": "#1E2126" },
        "lockedInk": { "$type": "color", "$value": "#5B616B" }
      },
      "heat": {
        "low": { "$type": "color", "$value": "#E8EEFC" },
        "high": { "$type": "color", "$value": "#2F5BEA" }
      },
      "hand": {
        "fill": { "$type": "color", "$value": "#3A3F47" },
        "line": { "$type": "color", "$value": "#6B7078" }
      }
    }
  },
  "opacity": {
    "fingerKeyFill": { "$type": "number", "$value": 0.22, "$description": "Finger colour over the key surface at levels L0 and L1." },
    "errorTint": { "$type": "number", "$value": 0.12 }
  },
  "font": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible", "system-ui", "sans-serif"] },
      "practice": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "practice": { "$type": "typography", "$value": { "fontFamily": "{font.family.practice}", "fontSize": "28px", "lineHeight": "40px", "fontWeight": 400 }, "$description": "Adjustable 22-40px in settings." },
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "32px", "lineHeight": "40px", "fontWeight": 700 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 } },
    "label": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 700 } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "key": { "$type": "dimension", "$value": "6px" },
    "card": { "$type": "dimension", "$value": "12px" },
    "panel": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "keyboard": {
    "unit": { "$type": "dimension", "$value": "48px", "$description": "Width of a 1u key on desktop; the keyboard scales by changing this." },
    "gap": { "$type": "dimension", "$value": "6px" }
  },
  "motion": {
    "reach": { "$type": "duration", "$value": "400ms", "$description": "Finger reach to the target key, ease-out." },
    "return": { "$type": "duration", "$value": "250ms" },
    "resultStrip": { "$type": "duration", "$value": "2000ms", "$description": "How long the line result stays unless a key is pressed." }
  },
  "target": {
    "touch": { "$type": "dimension", "$value": "44px", "$description": "Minimum size of any clickable control." }
  }
}
