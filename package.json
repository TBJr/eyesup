{
  "name": "eyesup",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @eyesup/web dev",
    "build": "pnpm tokens && pnpm -r --filter @eyesup/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/check-strings.mjs && pnpm -r --if-present lint",
    "pretest": "node scripts/patch-vitest-rpc-timeout.mjs",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "node scripts/size-check.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "validate-layouts": "node scripts/validate-layouts.mjs packages/layouts",
    "beta-report": "node scripts/beta-report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@vitest/coverage-v8": "^3.0.8",
    "svelte": "^5.20.5",
    "svelte-check": "^4.1.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
